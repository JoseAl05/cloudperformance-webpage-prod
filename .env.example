# Front end (Next.js). Copiar a .env.local y completar. Ninguna de estas variables debe exponerse al navegador
# salvo las NEXT_PUBLIC_*.

# --- Sesión ---
# Clave con la que se firma el JWT de sesión (la misma SECRET_KEY de las APIs)
JWT_SECRET=
# '1' sólo en local sin HTTPS: permite cookies de sesión no seguras
FORCE_INSECURE_COOKIES=

# --- Dominio público (redirecciones del middleware) ---
# 'true' en Vercel: usa PUBLIC_ORIGIN_VERCEL; si no, PUBLIC_ORIGIN_LOCAL (p. ej. http://localhost:3000)
IS_VERCEL=
PUBLIC_ORIGIN_LOCAL=
PUBLIC_ORIGIN_VERCEL=

# --- MongoDB (usuarios, empresas, conectores) ---
MONGODB_URI=
# Base de datos de usuarios (por defecto: appdb)
MONGODB_USER_DB=

# --- APIs back end (bridges /api/<servicio>/bridge). En desarrollo se usa la variable *_DEV si está definida ---
API_AWS_URL=
API_AWS_URL_DEV=
API_AZURE_URL=
API_AZURE_URL_DEV=
API_GCP_URL=
API_GCP_URL_DEV=
API_CLOUD_COMPARISON=
API_CLOUD_COMPARISON_DEV=
API_PRESUPUESTO=
API_PRESUPUESTO_DEV=
API_CONNECTORS=
API_CONNECTORS_DEV=
# El bridge agrega /alerts si la URL no lo incluye
API_ALERTAS_URL=
API_ALERTAS_URL_DEV=
# API de Open IA (API_OPENIA_URL se acepta como nombre antiguo)
API_OPENAI_URL=
# Tiempo máximo de espera de los bridges en ms (por defecto 120000)
BRIDGE_TIMEOUT_MS=

# --- Correo (verificación en dos pasos, recuperación de contraseña) ---
SMTP_HOST=
# Por defecto 587
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Nombre y URL de la aplicación en los correos (por defecto "Cloudperformance"; APP_URL o NEXT_PUBLIC_APP_URL)
APP_NAME=
APP_URL=
NEXT_PUBLIC_APP_URL=

# --- Licencias ---
# Clave privada con la que se firman las licencias (/api/op-licencias/generar)
INTAC_PRIVATE_KEY=

# --- New Relic (opcional) ---
# 'true' para cargar el agente; el agente lee además sus propias variables NEW_RELIC_* (nivel de log, tracing, etc.)
NEW_RELIC_ENABLED=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=
